import { createFileRoute } from "@tanstack/react-router";
import { useMemo, useState } from "react";
import { loadStripe } from "@stripe/stripe-js";
import { EmbeddedCheckoutProvider, EmbeddedCheckout } from "@stripe/react-stripe-js";
import { useCart } from "@/lib/cart-context";
import { createCheckoutSession } from "@/lib/checkout.functions";
import { motion, AnimatePresence } from "framer-motion";

export const Route = createFileRoute("/checkout/")({
  component: CheckoutPage,
});

const stripePromise = loadStripe(import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY as string);

const COUNTRIES = [
  { code: "GR", name: "Greece", phone: "+30" },
  { code: "CY", name: "Cyprus", phone: "+357" },
  { code: "US", name: "USA", phone: "+1" },
  { code: "GB", name: "UK", phone: "+44" },
  { code: "DE", name: "Germany", phone: "+49" },
  { code: "FR", name: "France", phone: "+33" },
  { code: "IT", name: "Italy", phone: "+39" },
  { code: "ES", name: "Spain", phone: "+34" },
];

type CheckoutForm = {
  firstName: string;
  lastName: string;
  email: string;
  phoneCountry: string;
  phone: string;
  address: string;
  city: string;
  postalCode: string;
  country: string;
  state: string;
};

function CheckoutPage() {
  const { items } = useCart();
  const [step, setStep] = useState(1);
  const [form, setForm] = useState<CheckoutForm>({
    firstName: "",
    lastName: "",
    email: "",
    phoneCountry: "+30",
    phone: "",
    address: "",
    city: "",
    postalCode: "",
    country: "GR",
    state: "",
  });
  const [clientSecret, setClientSecret] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  if (items.length === 0) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-kaif-black px-4 text-center font-mono text-xs tracking-[0.3em] text-kaif-chrome-dim">
        Η ΤΣΑΝΤΑ ΣΟΥ ΕΙΝΑΙ ΑΔΕΙΑ
      </div>
    );
  }

  async function proceedToPayment() {
    setLoading(true);
    setError(null);
    try {
      const res = await createCheckoutSession({
        data: {
          items: items.map((i) => ({ productId: i.productId, size: i.size, quantity: i.quantity })),
          customer: {
            firstName: form.firstName,
            lastName: form.lastName,
            email: form.email,
            phone: `${form.phoneCountry} ${form.phone}`,
          },
          shipping: {
            name: `${form.firstName} ${form.lastName}`,
            address: form.address,
            city: form.city,
            postal_code: form.postalCode,
            country: form.country,
            state: form.state,
          },
        },
      });
      if (!res.clientSecret) throw new Error("Αποτυχία δημιουργίας checkout session");
      setClientSecret(res.clientSecret);
      setStep(3);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Κάτι πήγε στραβά");
    } finally {
      setLoading(false);
    }
  }

  const nextStep = () => setStep((s) => s + 1);
  const prevStep = () => setStep((s) => s - 1);

  return (
    <div className="min-h-screen bg-kaif-black px-4 py-32 text-white">
      <div className="mx-auto max-w-2xl">
        <div className="mb-12 text-center">
          <h1 className="font-display text-5xl tracking-tight text-kaif-chrome">CHECKOUT</h1>
          <div className="mt-4 flex justify-center gap-2 font-mono text-[10px] tracking-[0.2em] text-kaif-chrome-dim">
            <span className={step >= 1 ? "text-kaif-toxic" : ""}>01 INFO</span>
            <span className="text-white/20">/</span>
            <span className={step >= 2 ? "text-kaif-toxic" : ""}>02 SHIPPING</span>
            <span className="text-white/20">/</span>
            <span className={step >= 3 ? "text-kaif-toxic" : ""}>03 PAYMENT</span>
          </div>
        </div>

        <AnimatePresence mode="wait">
          {step === 1 && (
            <motion.div
              key="step1"
              initial={{ opacity: 0, x: 20 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -20 }}
              className="space-y-6 border border-white/10 p-8 backdrop-blur-sm"
            >
              <h2 className="font-mono text-xs tracking-[0.3em] text-kaif-toxic">ΠΡΟΣΩΠΙΚΑ ΣΤΟΙΧΕΙΑ</h2>
              <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div className="flex flex-col gap-1">
                  <label className="font-mono text-[10px] text-kaif-chrome-dim">ΟΝΟΜΑ</label>
                  <input
                    type="text"
                    value={form.firstName}
                    onChange={(e) => setForm((f) => ({ ...f, firstName: e.target.value }))}
                    className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                    placeholder="John"
                  />
                </div>
                <div className="flex flex-col gap-1">
                  <label className="font-mono text-[10px] text-kaif-chrome-dim">ΕΠΙΘΕΜΑΡΙΟ</label>
                  <input
                    type="text"
                    value={form.lastName}
                    onChange={(e) => setForm((f) => ({ ...f, lastName: e.target.value }))}
                    className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                    placeholder="Doe"
                  />
                </div>
                <div className="flex flex-col gap-1 md:col-span-2">
                  <label className="font-mono text-[10px] text-kaif-chrome-dim">EMAIL</label>
                  <input
                    type="email"
                    value={form.email}
                    onChange={(e) => setForm((f) => ({ ...f, email: e.target.value }))}
                    className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                    placeholder="john@example.com"
                  />
                </div>
                <div className="flex flex-col gap-1 md:col-span-2">
                  <label className="font-mono text-[10px] text-kaif-chrome-dim">ΤΗΛΕΦΩΝΟ</label>
                  <div className="flex gap-2">
                    <select
                      value={form.phoneCountry}
                      onChange={(e) => setForm((f) => ({ ...f, phoneCountry: e.target.value }))}
                      className="border border-white/20 bg-kaif-black px-2 py-2 text-xs text-white outline-none focus:border-kaif-toxic"
                    >
                      {COUNTRIES.map((c) => (
                        <option key={c.code} value={c.phone}>
                          {c.phone} ({c.code})
                        </option>
                      ))}
                    </select>
                    <input
                      type="tel"
                      value={form.phone}
                      onChange={(e) => setForm((f) => ({ ...f, phone: e.target.value }))}
                      className="flex-1 border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                      placeholder="6900000000"
                    />
                  </div>
                </div>
              </div>
              <button
                onClick={nextStep}
                disabled={!form.firstName || !form.lastName || !form.email || !form.phone}
                className="w-full border border-kaif-toxic py-4 font-mono text-xs tracking-[0.4em] text-kaif-toxic hover:bg-kaif-toxic hover:text-kaif-black transition-colors disabled:opacity-30"
              >
                ΣΥΝΕΧΕΙΑ →
              </button>
            </motion.div>
          )}

          {step === 2 && (
            <motion.div
              key="step2"
              initial={{ opacity: 0, x: 20 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -20 }}
              className="space-y-6 border border-white/10 p-8 backdrop-blur-sm"
            >
              <h2 className="font-mono text-xs tracking-[0.3em] text-kaif-toxic">ΣΤΟΙΧΕΙΑ ΑΠΟΣΤΟΛΗΣ</h2>
              <div className="grid grid-cols-1 gap-4">
                <div className="flex flex-col gap-1">
                  <label className="font-mono text-[10px] text-kaif-chrome-dim">ΔΙΕΥΘΥΝΣΗ</label>
                  <input
                    type="text"
                    value={form.address}
                    onChange={(e) => setForm((f) => ({ ...f, address: e.target.value }))}
                    className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                    placeholder="Street name 123"
                  />
                </div>
                <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div className="flex flex-col gap-1">
                    <label className="font-mono text-[10px] text-kaif-chrome-dim">ΠΟΛΗ</label>
                    <input
                      type="text"
                      value={form.city}
                      onChange={(e) => setForm((f) => ({ ...f, city: e.target.value }))}
                      className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                      placeholder="Athens"
                    />
                  </div>
                  <div className="flex flex-col gap-1">
                    <label className="font-mono text-[10px] text-kaif-chrome-dim">ΤΑΧΥΔΡΟΜΙΚΟΣ ΚΩΔΙΚΑΣ</label>
                    <input
                      type="text"
                      value={form.postalCode}
                      onChange={(e) => setForm((f) => ({ ...f, postalCode: e.target.value }))}
                      className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                      placeholder="10431"
                    />
                  </div>
                </div>
                <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div className="flex flex-col gap-1">
                    <label className="font-mono text-[10px] text-kaif-chrome-dim">ΧΩΡΑ</label>
                    <select
                      value={form.country}
                      onChange={(e) => setForm((f) => ({ ...f, country: e.target.value }))}
                      className="border border-white/20 bg-kaif-black px-3 py-2 text-white outline-none focus:border-kaif-toxic"
                    >
                      {COUNTRIES.map((c) => (
                        <option key={c.code} value={c.code}>
                          {c.name}
                        </option>
                      ))}
                    </select>
                  </div>
                  <div className="flex flex-col gap-1">
                    <label className="font-mono text-[10px] text-kaif-chrome-dim">ΠΕΡΙΟΧΗ / STATE</label>
                    <input
                      type="text"
                      value={form.state}
                      onChange={(e) => setForm((f) => ({ ...f, state: e.target.value }))}
                      className="border border-white/20 bg-transparent px-3 py-2 text-white focus:border-kaif-toxic outline-none transition-colors"
                      placeholder="Attica"
                    />
                  </div>
                </div>
              </div>
              <div className="flex gap-3">
                <button
                  onClick={prevStep}
                  className="flex-1 border border-white/20 py-4 font-mono text-xs tracking-[0.4em] text-kaif-chrome-dim hover:border-white/40 transition-colors"
                >
                  ΠΙΣΩ
                </button>
                <button
                  onClick={proceedToPayment}
                  disabled={loading || !form.address || !form.city || !form.postalCode}
                  className="flex-1 border border-kaif-toxic py-4 font-mono text-xs tracking-[0.4em] text-kaif-toxic hover:bg-kaif-toxic hover:text-kaif-black transition-colors disabled:opacity-30"
                >
                  {loading ? "..." : "ΠΛΗΡΩΜΗ →"}
                </button>
              </div>
              {error && <p className="text-center font-mono text-[10px] text-red-500">{error}</p>}
            </motion.div>
          )}

          {step === 3 && (
            <motion.div
              key="step3"
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              className="min-h-[500px]"
            >
              <EmbeddedCheckoutProvider stripe={stripePromise} options={{ fetchClientSecret: async () => clientSecret! }}>
                <EmbeddedCheckout />
              </EmbeddedCheckoutProvider>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}
